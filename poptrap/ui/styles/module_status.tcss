/* Module unavailability screen layout */

ModuleStatusScreen .module-frame {
    width: 64;
    max-width: 100%;
    height: auto;
}

.status-row {
    width: 100%;
    height: auto;
    layout: horizontal;
    margin-bottom: 1;
}

ModuleStatusScreen.compact .status-row {
    margin-bottom: 0;
}

.status-key {
    width: 14;
    color: $text-dim;
}

.status-value {
    width: 1fr;
    color: $foreground;
}

.status-value-accent {
    width: 1fr;
    color: $primary;
}

.module-actions {
    width: 100%;
    height: 1;
    layout: horizontal;
    margin-top: 2;
}

ModuleStatusScreen.compact .module-actions {
    margin-top: 1;
}
