/* POPTRAP Phase 2 — Create Prank and Preview screen styling */

CreatePrankScreen .prank-frame,
PrankPreviewScreen .preview-frame {
    width: 72;
    max-width: 100%;
    height: 1fr;
    max-height: 28;
}

CreatePrankScreen.compact .prank-frame,
PrankPreviewScreen.compact .preview-frame {
    height: 1fr;
    max-height: 100%;
}

#prank-mode-bar {
    width: 100%;
    height: 1;
    layout: horizontal;
    margin-bottom: 1;
}

CreatePrankScreen.compact #prank-mode-bar {
    margin-bottom: 0;
}

#prank-mode-bar Button.mode-active {
    color: $primary;
    text-style: bold;
}

#prank-scroll,
#preview-scroll {
    width: 100%;
    height: 1fr;
    background: $background;
    border: none;
    scrollbar-size-vertical: 1;
}

.prank-row {
    width: 100%;
    height: auto;
    min-height: 1;
    layout: horizontal;
    align-vertical: middle;
    margin-bottom: 0;
}

.prank-row.hidden {
    display: none;
}

.prank-label {
    width: 17;
    height: 1;
    color: $text-dim;
}

CreatePrankScreen.compact .prank-label {
    width: 14;
}

#prank-template-summary {
    width: 100%;
    height: auto;
    color: $secondary;
    margin-bottom: 1;
}

CreatePrankScreen.compact #prank-template-summary {
    margin-bottom: 0;
}

/* Flat minimal Input styling matching Phase 1 Select/Switch */
CreatePrankScreen Input {
    width: 1fr;
    height: 1;
    border: none;
    background: $surface;
    color: $foreground;
    padding: 0 1;
}

CreatePrankScreen Input:focus {
    border: none;
    background: $panel;
    color: $foreground;
}

CreatePrankScreen Input.short-input {
    width: 14;
}

CreatePrankScreen Select {
    width: 34;
    max-width: 1fr;
    height: auto;
}

CreatePrankScreen Select > SelectCurrent {
    border: none;
    background: $surface;
    color: $foreground;
    padding: 0 1;
    height: 1;
}

CreatePrankScreen Select:focus > SelectCurrent {
    border: none;
    background: $panel;
    color: $primary;
    text-style: bold;
}

CreatePrankScreen SelectOverlay {
    background: $surface;
    border: tall $border-subtle;
    color: $foreground;
}

.toggle-group {
    width: 1fr;
    height: 1;
    layout: horizontal;
    align-vertical: middle;
}

CreatePrankScreen Switch {
    border: none;
    background: $surface;
    padding: 0 1;
    height: 1;
    width: auto;
}

CreatePrankScreen Switch:focus {
    background: $panel;
}

CreatePrankScreen Switch > .switch--slider {
    color: $text-dim;
    background: $surface;
}

CreatePrankScreen Switch.-on > .switch--slider {
    color: $primary;
    background: $surface;
}

.toggle-state-label {
    margin-left: 2;
    height: 1;
    color: $foreground;
}

/* Live Local Server Session Panel */
#session-panel {
    width: 100%;
    height: auto;
    background: $surface;
    padding: 0 1;
    margin-top: 1;
}

CreatePrankScreen.compact #session-panel {
    margin-top: 0;
}

#session-panel.hidden {
    display: none;
}

.session-line {
    width: 100%;
    height: auto;
    layout: horizontal;
}

.session-key {
    width: 14;
    color: $text-dim;
}

.session-url {
    width: 1fr;
    color: $primary;
    text-style: bold;
}

.session-val {
    width: 1fr;
    color: $foreground;
}

#prank-feedback {
    width: 100%;
    height: auto;
    min-height: 1;
    color: $primary;
}

#prank-feedback.error {
    color: $error;
}

.prank-actions,
.preview-actions {
    width: 100%;
    height: 1;
    layout: horizontal;
    margin-top: 1;
}

CreatePrankScreen.compact .prank-actions,
PrankPreviewScreen.compact .preview-actions {
    margin-top: 0;
}

CreatePrankScreen.compact Button.action-btn,
PrankPreviewScreen.compact Button.action-btn {
    min-width: 7;
    padding: 0 1;
    margin-right: 1;
}

Button.action-btn.hidden {
    display: none;
}

/* Preview screen rows */
.preview-row {
    width: 100%;
    height: auto;
    layout: horizontal;
    margin-bottom: 1;
}

PrankPreviewScreen.compact .preview-row {
    margin-bottom: 0;
}

.preview-key {
    width: 16;
    color: $text-dim;
}

.preview-val {
    width: 1fr;
    color: $foreground;
}

.preview-val-accent {
    width: 1fr;
    color: $primary;
}
