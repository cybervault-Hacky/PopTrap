/* Phase 6 uses the existing charcoal surface and $primary accents. */
.delivery-shell {
    width: 100%;
    height: 1fr;
    max-width: 100;
    padding: 0 2;
    align: left top;
}

.delivery-title {
    height: 1;
    color: $primary;
    text-style: bold;
}

#delivery-address {
    height: auto;
    color: $text-muted;
}

#delivery-workspace {
    height: 1fr;
    scrollbar-size: 1 1;
}

.delivery-section {
    height: auto;
    margin: 0 0 1 0;
}

.delivery-heading {
    height: auto;
    color: $primary;
    text-style: bold;
}

.delivery-actions {
    height: auto;
}

.delivery-actions Button.action-btn, .delivery-shell Button.action-btn {
    min-width: 0;
    padding: 0 1;
    margin-right: 1;
}

.delivery-nav {
    height: 1;
}

#delivery-devices, #delivery-invites {
    height: auto;
    max-height: 7;
    min-height: 2;
    padding: 0;
    border: none;
    background: $surface;
}

#delivery-interface, #delivery-experience {
    height: auto;
}

#delivery-feedback {
    height: auto;
    max-height: 2;
    color: $primary;
}

InvitationQrScreen #delivery-qr-code {
    height: 1fr;
    padding: 0;
    content-align: center middle;
}

#delivery-qr-resize {
    height: 1fr;
    padding: 0 2;
    content-align: center middle;
}
